generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer / Prisma Accelerate / Neon pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by `prisma migrate` / `prisma db push`.
  // Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  // Bumped to invalidate all existing JWTs for this user (logout-everywhere / suspend).
  tokenVersion Int      @default(0)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Analytics filters on (role, status, createdAt); plan distribution joins on planId.
  @@index([role, status, createdAt])
  @@index([planId])
  @@index([createdAt])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  period      String   @default("month")
  description String
  features    String
  maxProjects Int      @default(10)
  maxUsers    Int      @default(1)
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  phone         String?
  company       String?
  address       String?
  plan          String       @default("standard")
  notes         String?
  status        String       @default("active")
  paymentStatus String       @default("pending")
  licenses      License[]
  apiKeys       ApiKey[]
  clientNotes   ClientNote[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model License {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  machineId  String
  seats      Int      @default(1)
  issued     DateTime @default(now())
  expiry     DateTime
  status     String   @default("active")
  licenseKey String   @unique
  fileName   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([clientId])
  // Dashboard "expiring soon" / alerts query filters on (status, expiry).
  @@index([status, expiry])
  @@index([createdAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String
  keyPrefix String
  scopes    String    @default("[]")
  status    String    @default("active")
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  // Runtime key verification looks up by prefix, then constant-time compares the hash.
  @@index([keyPrefix])
  @@index([createdAt])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PendingPayment {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  planName  String
  amount    Float
  utr       String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  // Fast-growing table: index the columns the activity feed filters/sorts on.
  @@index([createdAt])
  @@index([action, createdAt])
}
