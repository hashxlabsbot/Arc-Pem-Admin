generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer / Prisma Accelerate / Neon pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by `prisma migrate` / `prisma db push`.
  // Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  // Marks users acquired during the early-access launch window (e.g. the June 20
  // event). The product ships later; this flags the cohort to onboard at go-live.
  earlyAccess  Boolean  @default(false)
  // Bumped to invalidate all existing JWTs for this user (logout-everywhere / suspend).
  tokenVersion Int      @default(0)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  // End of the current one-year license term. Set when a paid plan is activated
  // (Razorpay webhook / manual approval) to now + 1 year; null = no active paid
  // license. Drives "Expires on…" on the customer dashboard and renewal reminders.
  planExpiresAt DateTime?
  billingProfile BillingProfile?
  invoices     Invoice[]
  // ARC PEM Web (app.arcpem.com): the firm this user owns there, if they bought the web plan.
  webSubscription WebSubscription?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Analytics filters on (role, status, createdAt); plan distribution joins on planId.
  @@index([role, status, createdAt])
  @@index([planId])
  @@index([createdAt])
  // Admin counts/filters the early-access launch cohort.
  @@index([earlyAccess])
}

// Generic key/value app configuration, editable from admin Settings. Used for
// runtime toggles such as `earlyAccessOpen` (gates public registration at launch).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  period      String   @default("month")
  description String
  features    String
  maxProjects Int      @default(10)
  maxUsers    Int      @default(1)
  // WEB plans: site seats included (Site engineer, Supervisor). 100000 = unlimited.
  maxSiteUsers Int     @default(0)
  isActive    Boolean  @default(true)
  // DESKTOP = machine-licensed desktop app (sets User.planId); WEB = ARC PEM Web at app.arcpem.com (a WebSubscription).
  product     String   @default("DESKTOP")
  // WEB plans only: the app's plan tier, SOLO | STUDIO | BUSINESS | ENTERPRISE. maxProjects/maxUsers are its project/seat limits.
  tier        String?
  users       User[]
  webSubscriptions WebSubscription[]
  razorpayPlans    RazorpayPlan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([product, isActive])
}

// ── ARC PEM Web (app.arcpem.com) ─────────────────────────────────────────────
// The web app keeps its own database. These tables are what it is told: who owns which firm, on which plan, until
// when. Every change is queued in WebhookOutbox and pushed to the app; the app also reads it at owner sign-in.

/// One firm's web subscription, owned by the user who bought it (the firm owner who signs in to the app).
model WebSubscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName         String
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  // ACTIVE | PAST_DUE | EXPIRED | SUSPENDED | CANCELED. Lapsing at currentPeriodEnd is handled by the app itself.
  status           String    @default("ACTIVE")
  currentPeriodEnd DateTime?
  // Overrides of the plan's seats/projects (extra seats, custom deals); null = the plan's maxUsers/maxProjects.
  seatLimit        Int?
  projectLimit     Int?
  // MONTH | YEAR. Renewed automatically while autoRenew is true (a Razorpay subscription is running).
  billingInterval  String    @default("YEAR")
  autoRenew        Boolean   @default(false)
  siteSeatLimit    Int?
  // Add-on seats bought with the current subscription, on top of the plan's.
  extraSeats       Int       @default(0)
  extraSiteSeats   Int       @default(0)
  // Set while the firm is on its free trial (no payment taken yet).
  trialEndsAt      DateTime?
  razorpaySubscriptionId String? @unique
  payments         WebSubscriptionPayment[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, currentPeriodEnd])
}

/// The Razorpay plan object behind each (plan, billing interval, price); a price change gets a new one.
model RazorpayPlan {
  id              String   @id
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingInterval String
  amountPaise     Int
  createdAt       DateTime @default(now())

  @@unique([planId, billingInterval, amountPaise])
}

/// Each paid term. `paymentRef` is unique, so a payment reported twice (website + admin webhooks, retries) extends
/// the subscription exactly once.
model WebSubscriptionPayment {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   WebSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentRef     String          @unique
  planId         String
  amount         Float
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime        @default(now())

  @@index([subscriptionId, createdAt])
}

/// Events waiting to be delivered to app.arcpem.com (transactional outbox: written in the same transaction as the
/// change, delivered after, retried with backoff until acknowledged).
model WebhookOutbox {
  id            String    @id
  type          String
  payload       Json
  // PENDING | DELIVERED | FAILED (gave up after max attempts; retry from admin)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

/// Single-use OpenID Connect authorization codes issued by arcpem.com to app.arcpem.com (stored hashed).
model OidcAuthCode {
  codeHash      String   @id
  userId        String
  clientId      String
  redirectUri   String
  scope         String
  nonce         String?
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model Client {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?
  company         String?
  address         String?
  plan            String           @default("standard")
  notes           String?
  status          String           @default("active")
  paymentStatus   String           @default("pending")
  licenses        License[]
  apiKeys         ApiKey[]
  clientNotes     ClientNote[]
  licenseRequests LicenseRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model License {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  machineId  String
  seats      Int      @default(1)
  issued     DateTime @default(now())
  expiry     DateTime
  status     String   @default("active")
  licenseKey String   @unique
  fileName   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([clientId])
  // Dashboard "expiring soon" / alerts query filters on (status, expiry).
  @@index([status, expiry])
  @@index([createdAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String
  keyPrefix String
  scopes    String    @default("[]")
  status    String    @default("active")
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  // Runtime key verification looks up by prefix, then constant-time compares the hash.
  @@index([keyPrefix])
  @@index([createdAt])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PendingPayment {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  planName  String
  amount    Float
  utr       String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  // Fast-growing table: index the columns the activity feed filters/sorts on.
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityId, createdAt])
}

// Buyer's GST/billing details, collected at plan purchase. One per user.
model BillingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName    String
  gstin        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  // 2-digit GST state code (e.g. "27" for Maharashtra). Drives intra/inter-state tax split.
  stateCode    String
  pincode      String
  country      String   @default("India")
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Single-row seller (our company) GST profile, editable from admin Settings.
model SellerProfile {
  id            String   @id @default(cuid())
  legalName     String
  gstin         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  stateCode     String
  pincode       String
  email         String?
  phone         String?
  // SAC code for SaaS / IT services; tax rate applied to plan price.
  hsnSac        String   @default("998314")
  taxRate       Float    @default(18)
  invoicePrefix String   @default("ARC")
  bankDetails   String?
  updatedAt     DateTime @updatedAt
}

// Machine ID requests submitted by users from the customer dashboard.
// Admin reviews and issues a signed license once verified.
model LicenseRequest {
  id        String   @id @default(cuid())
  // Linked to an existing Client once the request is matched or approved.
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Optional: the User record if the requester is a registered subscriber.
  userId    String?
  name      String
  email     String
  machineId String
  notes     String?
  // pending | approved | rejected
  status    String   @default("pending")
  // Populated once admin approves and a License row is created.
  licenseId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([clientId])
}

// Immutable GST tax invoice generated when a payment is approved.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Links the approved PendingPayment that triggered this invoice (one invoice per payment).
  paymentId     String?  @unique
  planName      String

  // Snapshot of buyer details at issue time (so later profile edits never alter past invoices).
  buyerName      String
  buyerGstin     String?
  buyerAddress   String
  buyerStateCode String

  // Snapshot of seller details at issue time.
  sellerName      String
  sellerGstin     String
  sellerAddress   String
  sellerStateCode String

  placeOfSupply String
  hsnSac        String
  taxRate       Float
  taxableAmount Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  total         Float
  currency      String   @default("INR")
  // Rendered PDF bytes, served on download.
  pdf           Bytes
  issuedAt      DateTime @default(now())

  @@index([userId])
  @@index([issuedAt])
}

// Demo requests submitted from the marketing site's "Book a Free Demo" modal.
// Written by Arch-Pem-Website-User (which mirrors this model — see that repo's
// schema.prisma), read/managed here under Admin → Demo Bookings.
model DemoBooking {
  id              String   @id @default(cuid())
  name            String
  email           String
  whatsapp        String
  company         String?
  role            String?
  teamSize        String?
  preferredDate   String?
  preferredTime   String?
  // Google Meet link + Calendar event id, set once the calendar event is created.
  meetLink        String?
  calendarEventId String?
  // PENDING | CONFIRMED (Meet link generated) | FAILED (Meet generation failed — needs a manual link)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// Blog / CMS — authored in this admin app, read by the marketing site
// (Arch-Pem-Website-User) which mirrors this model and reads the same table.
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  contentMarkdown String
  category        String
  tags            String[]
  authorName      String?
  authorRole      String?
  coverImage      String?
  coverImageAlt   String?
  seoTitle        String?
  featured        Boolean   @default(false)
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt     DateTime?
  updatedDate     DateTime? // deliberate "Updated" editorial signal, not the auto updatedAt
  relatedTools    String[]
  relatedPosts    String[]
  faq             Json?     // [{ q, a }]
  howto           Json?     // { name, description, steps: [{ name, text }] }
  viewCount       Int       @default(0) // denormalised all-time total (cheap sort/display)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// Per-day rollup of blog traffic. Written by the marketing site's /api/blog/view
// beacon; read by the admin analytics dashboard.
model BlogPostView {
  id      String   @id @default(cuid())
  slug    String
  date    DateTime @db.Date
  views   Int      @default(0)
  uniques Int      @default(0)

  @@unique([slug, date])
  @@index([slug])
}

// One row per (post, day, visitor) — bounded de-dup that drives the `uniques`
// (reach) counter. Insert fails on the composite PK for a repeat visitor.
model BlogPostVisit {
  slug        String
  date        DateTime @db.Date
  visitorHash String

  @@id([slug, date, visitorHash])
}

/// Billing rules editable from admin Settings (one row, id 'default'). Mirrored in the customer website's schema.
model BillingSettings {
  id                   String   @id @default("default")
  seatAddonMonthly     Int      @default(599)
  siteSeatAddonMonthly Int      @default(199)
  annualBilledMonths   Int      @default(10)
  trialDays            Int      @default(14)
  maxAddonSeats        Int      @default(50)
  updatedAt            DateTime @default(now()) @updatedAt
  updatedBy            String?
}
