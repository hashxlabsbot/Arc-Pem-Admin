# ---------------------------------------------------------------------------
# PostgreSQL
# DATABASE_URL  = pooled connection used by the app at runtime (PgBouncer /
#                 Neon pooler / Prisma Accelerate). Behind an external pooler,
#                 connection_limit is how many connections Prisma opens *to the
#                 pooler* — set it high enough for pages that fan out parallel
#                 queries (the dashboard fires ~17 via Promise.all), e.g.
#                 ?pgbouncer=true&connection_limit=10&pool_timeout=20
# DIRECT_URL    = direct (non-pooled) connection used by `prisma migrate`.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/arcpem?schema=public&pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/arcpem?schema=public"

NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Bootstrap admin login — authenticates directly against these values without
# a DB row, so the admin can sign in even before the users table is seeded.
# Use a strong, unique password; it is read in plaintext from the environment.
ADMIN_EMAIL="admin@arcpem.com"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Comma-separated hosts allowed for Server Actions (defaults to NEXTAUTH_URL host)
# e.g. admin.arcpem.com
ALLOWED_ORIGINS="localhost:3000"

# RSA-2048 private key for license signing — generate with scripts/generate-keys.ts
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Brevo transactional email — get keys at app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
BREVO_SENDER_EMAIL="your-sender@email.com"

# User-facing web app URL (used in email links sent to users)
WEB_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Upstash Redis (REST) — REQUIRED for cross-instance rate limiting in
# production. If unset, the rate limiter falls back to per-instance memory.
# Get credentials at console.upstash.com
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Blog publish -> marketing site revalidation
MARKETING_URL=https://arcpem.com
NEXT_PUBLIC_MARKETING_URL=https://arcpem.com
REVALIDATE_SECRET=

# Live blog preview: sign preview tokens for the marketing /blog/preview iframe (match marketing PREVIEW_SECRET)
PREVIEW_SECRET=
