# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Environment variables — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma — SQLite database files
prisma/*.db
prisma/*.db-shm
prisma/*.db-wal

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# License key material — never commit private keys
*.pem
scripts/license-private.pem
scripts/license-public.pem
